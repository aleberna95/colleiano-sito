rules_version = '2';

// Stessi permessi di firestore.rules, letti da Firestore.
service firebase.storage {
  match /b/{bucket}/o {
    function isSuperadmin() { return request.auth != null && request.auth.token.get("superadmin", false) == true; }
    function m(f) { return firestore.get(/databases/(default)/documents/feste/$(f)/membri/$(request.auth.uid)).data; }
    function isMembro(f) { return request.auth != null && m(f).attivo == true; }
    function isAdmin(f) { return isSuperadmin() || (isMembro(f) && m(f).ruoloFesta == "admin"); }
    function scrivibile(f) { return isSuperadmin() || firestore.get(/databases/(default)/documents/feste/$(f)).data.stato != "archiviata"; }

    // Allegati dei task (SPEC 4.4): li vede la festa; li caricano responsabile, referenti e admin.
    match /feste/{f}/tasks/{t}/{file} {
      function puoAllegare() {
        let task = firestore.get(/databases/(default)/documents/feste/$(f)/tasks/$(t)).data;
        return isAdmin(f)
          || (isMembro(f) && (m(f).commissioni.get(task.commissioneId, null) == "referente" || task.responsabileUid == request.auth.uid));
      }
      allow read: if isSuperadmin() || isMembro(f);
      allow create: if scrivibile(f) && puoAllegare()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches("image/.*|application/pdf");
      allow delete: if scrivibile(f) && puoAllegare();
    }

    // Scontrini delle spese (SPEC 6.4): la foto si carica prima di inviare la spesa,
    // quindi basta essere della festa; li tolgono l'autore della spesa e gli admin.
    match /feste/{f}/movimenti/{mv}/{file} {
      allow read: if isSuperadmin() || isMembro(f);
      allow create: if scrivibile(f) && (isSuperadmin() || isMembro(f))
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches("image/.*|application/pdf");
      allow delete: if scrivibile(f) && (isAdmin(f)
        || (isMembro(f) && firestore.get(/databases/(default)/documents/feste/$(f)/movimenti/$(mv)).data.createdBy == request.auth.uid));
    }

    // Immagini del sito pubblico (SPEC 7.1): le vede chiunque.
    // Quelle di una festa le caricano i suoi admin, quelle generali solo il superadmin.
    function immagine() { return request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches("image/.*"); }
    match /sito/feste/{f}/{file} {
      allow read: if true;
      allow create: if scrivibile(f) && isAdmin(f) && immagine();
      allow delete: if scrivibile(f) && isAdmin(f);
    }
    match /sito/generale/{file} {
      allow read: if true;
      allow create: if isSuperadmin() && immagine();
      allow delete: if isSuperadmin();
    }

    // Tutto il resto è chiuso.
  }
}
