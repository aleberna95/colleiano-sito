rules_version = '2';

// Le regole sono la fonte di verità dei permessi (SPEC 4).
// lib/permissions.ts le replica per la UI: tenerli allineati.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSuperadmin() { return signedIn() && request.auth.token.get("superadmin", false) == true; }
    function m(f) { return get(/databases/$(database)/documents/feste/$(f)/membri/$(request.auth.uid)).data; }
    function isMembro(f) { return signedIn() && exists(/databases/$(database)/documents/feste/$(f)/membri/$(request.auth.uid)) && m(f).attivo == true; }
    function isAdmin(f) { return isSuperadmin() || (isMembro(f) && m(f).ruoloFesta == "admin"); }
    function ruolo(f, c) { return m(f).commissioni.get(c, null); }
    function isReferente(f, c) { return isMembro(f) && ruolo(f, c) == "referente"; }
    function canManage(f, c) { return isAdmin(f) || isReferente(f, c); }

    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function changedOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // Tutto ciò che non è aperto qui sotto resta chiuso.

    // Profili: li crea e modifica la Function (o lo script di bootstrap).
    // L'utente può solo segnare di aver cambiato la password e ricordare l'ultima festa.
    match /users/{uid} {
      allow read: if isSelf(uid) || isSuperadmin();
      allow update: if isSelf(uid)
        && resource.data.attivo == true
        && changedOnly(["devoCambiarePassword", "ultimaFestaId", "updatedAt", "updatedBy"])
        && request.resource.data.devoCambiarePassword == false
        && request.resource.data.updatedBy == uid
        && request.resource.data.updatedAt == request.time
        && (!("ultimaFestaId" in request.resource.data) || request.resource.data.ultimaFestaId is string);
    }

    function festa(f) { return get(/databases/$(database)/documents/feste/$(f)).data; }
    // Festa archiviata: sola lettura, tranne per i superadmin (SPEC 4.6).
    function scrivibile(f) { return isSuperadmin() || festa(f).stato != "archiviata"; }
    function auditUpdate() {
      return request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
    }
    function auditCreate() {
      return auditUpdate() && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
    }
    function optInt(d, k) { return !(k in d) || (d[k] is int && d[k] >= 0); }
    function optString(d, k, max) { return !(k in d) || (d[k] is string && d[k].size() <= max); }

    // ---- Sito pubblico (SPEC 7.3) ----

    function urlValido(u) { return u is string && u.size() <= 1000 && u.matches("https?://.+"); }
    function urlOpt(d, k) { return !(k in d) || urlValido(d[k]); }
    function paginaValida(p) {
      return p is map && p.keys().hasOnly(["testo", "copertina", "galleria"])
        && optString(p, "testo", 5000)
        && urlOpt(p, "copertina")
        && p.galleria is list && p.galleria.size() <= 30;
    }
    function configValida(d) {
      return d.keys().hasOnly(["festaInEvidenzaId", "chiSiamo", "comeArrivare", "indirizzo", "linkMappe", "faq",
             "immagineCopertina", "updatedAt", "updatedBy"])
        && d.chiSiamo is string && d.chiSiamo.size() <= 5000
        && d.comeArrivare is string && d.comeArrivare.size() <= 5000
        && d.indirizzo is string && d.indirizzo.size() <= 200
        && (d.linkMappe == "" || urlValido(d.linkMappe))
        && d.faq is list && d.faq.size() <= 30
        && urlOpt(d, "immagineCopertina")
        && (!("festaInEvidenzaId" in d) || (d.festaInEvidenzaId is string
          && exists(/databases/$(database)/documents/feste/$(d.festaInEvidenzaId))));
    }
    function inEvidenza(f) {
      return exists(/databases/$(database)/documents/sito/config)
        && get(/databases/$(database)/documents/sito/config).data.get("festaInEvidenzaId", null) == f;
    }

    // Testi del sito e festa in evidenza: li legge chiunque, li scrive solo il superadmin.
    match /sito/{doc} {
      allow read: if doc == "config";
      allow create, update: if doc == "config" && isSuperadmin()
        && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time
        && configValida(request.resource.data);
    }

    // Copia pubblica dei dati della festa, scritta solo dalla Function sitoFesta.
    // La vede chiunque solo se la festa è in evidenza o nell'archivio; i membri sempre (anteprima).
    match /sitoFeste/{f} {
      allow read: if resource.data.inArchivioPubblico == true || inEvidenza(f) || isMembro(f) || isSuperadmin();
    }

    // "Le mie feste": ognuno trova i propri documenti membro con una query collection group.
    match /{path=**}/membri/{uid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /feste/{f} {
      // Vedere: ogni membro vede tutto della sua festa (SPEC 4.2).
      allow read: if isMembro(f) || isSuperadmin();

      // Le crea la Function. L'admin modifica i dati; solo il superadmin archivia o riapre.
      allow update: if auditUpdate()
        && changedOnly(["nome", "dataFesta", "luogo", "stato", "budgetTotaleCents", "categorieSpesa", "updatedAt", "updatedBy"])
        && request.resource.data.nome is string && request.resource.data.nome.size() >= 3 && request.resource.data.nome.size() <= 80
        && (!("dataFesta" in request.resource.data) || request.resource.data.dataFesta is timestamp)
        && optString(request.resource.data, "luogo", 120)
        && optInt(request.resource.data, "budgetTotaleCents")
        && request.resource.data.categorieSpesa is list && request.resource.data.categorieSpesa.size() <= 30
        && request.resource.data.stato in ["preparazione", "in_corso", "conclusa", "archiviata"]
        && (isSuperadmin()
          || (isAdmin(f) && resource.data.stato != "archiviata" && request.resource.data.stato != "archiviata"));

      // Sito pubblico (SPEC 7.1): l'admin cura pagina e modalità festa; solo il superadmin mette in archivio.
      allow update: if auditUpdate()
        && changedOnly(["paginaPubblica", "modalitaFesta", "inArchivioPubblico", "updatedAt", "updatedBy"])
        && (!("paginaPubblica" in request.resource.data) || paginaValida(request.resource.data.paginaPubblica))
        && (!("modalitaFesta" in request.resource.data) || request.resource.data.modalitaFesta is bool)
        && (!("inArchivioPubblico" in request.resource.data) || request.resource.data.inArchivioPubblico is bool)
        && (isSuperadmin()
          || (isAdmin(f) && resource.data.stato != "archiviata"
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["inArchivioPubblico"])));

      // Scritti solo dalle Functions (SPEC 4.6).
      match /membri/{uid} {
        allow read: if isMembro(f) || isSuperadmin();
      }

      match /storico/{id} {
        allow read: if isMembro(f) || isSuperadmin();
      }

      function commissioneValida(d) {
        return d.nome is string && d.nome.size() >= 2 && d.nome.size() <= 40
          && d.colore in ["giallo", "arancio", "viola", "verde", "rosso", "blu", "teal", "grigio"]
          && d.icona is string && d.icona.size() <= 40
          && d.ordine is int
          && optInt(d, "budgetCents")
          && optString(d, "descrizione", 500);
      }

      // Commissioni: le crea e modifica l'admin; i referenti solo la descrizione (SPEC 4.6).
      // referentiUids/componentiUids li allinea la Function dai ruoli dei membri.
      match /commissioni/{c} {
        allow read: if isMembro(f) || isSuperadmin();
        allow create: if isAdmin(f) && scrivibile(f) && auditCreate()
          && request.resource.data.keys().hasOnly(["nome", "descrizione", "icona", "colore", "ordine", "generale", "budgetCents",
               "referentiUids", "componentiUids", "createdAt", "createdBy", "updatedAt", "updatedBy"])
          && commissioneValida(request.resource.data)
          && request.resource.data.generale == false
          && request.resource.data.referentiUids == []
          && request.resource.data.componentiUids == [];
        allow update: if scrivibile(f) && auditUpdate() && (
          (isAdmin(f)
            && changedOnly(["nome", "descrizione", "icona", "colore", "ordine", "budgetCents", "updatedAt", "updatedBy"])
            && commissioneValida(request.resource.data)
            && (resource.data.generale == false || request.resource.data.nome == resource.data.nome))
          || (isReferente(f, c)
            && changedOnly(["descrizione", "updatedAt", "updatedBy"])
            && optString(request.resource.data, "descrizione", 500))
        );
      }

      // ---- Task e richieste (SPEC 4.4) ----

      function io() { return request.auth.uid; }
      function membroDi(uid) { return get(/databases/$(database)/documents/feste/$(f)/membri/$(uid)).data; }
      function attivo(uid) { return membroDi(uid).attivo == true; }
      function ruoloDi(uid, c) { return membroDi(uid).commissioni.get(c, null); }
      function commissioneEsiste(c) { return exists(/databases/$(database)/documents/feste/$(f)/commissioni/$(c)); }

      // A chi posso dare un task della commissione c: pari o sotto, dentro il proprio ambito.
      // null = "da assegnare", permesso solo a referenti e admin.
      function puoAssegnare(c, resp) {
        return isAdmin(f) ? (resp == null || attivo(resp))
          : isReferente(f, c) ? (resp == null || (attivo(resp) && ruoloDi(resp, c) in ["referente", "componente"]))
          : isMembro(f) && ruolo(f, c) == "componente" && resp != null && attivo(resp) && ruoloDi(resp, c) == "componente";
      }

      function taskValido(d) {
        return d.keys().hasOnly(["titolo", "descrizione", "commissioneId", "responsabileUid", "stato", "richiestoDa",
               "motivoBlocco", "motivoRifiuto", "priorita", "scadenza", "checklist", "link", "eliminato",
               "createdAt", "createdBy", "updatedAt", "updatedBy"])
          && d.keys().hasAll(["titolo", "commissioneId", "responsabileUid", "stato", "priorita", "checklist", "link", "eliminato"])
          && d.titolo is string && d.titolo.size() >= 1 && d.titolo.size() <= 200
          && optString(d, "descrizione", 2000)
          && optString(d, "motivoBlocco", 500)
          && optString(d, "motivoRifiuto", 500)
          && d.commissioneId is string
          && (d.responsabileUid == null || d.responsabileUid is string)
          && d.stato in ["richiesta", "da_fare", "in_corso", "bloccato", "fatto", "annullato"]
          && d.priorita in ["normale", "urgente"]
          && (!("scadenza" in d) || d.scadenza is timestamp)
          && d.checklist is list && d.checklist.size() <= 50
          && d.link is list && d.link.size() <= 20
          && d.eliminato is bool
          // Una richiesta non ha ancora responsabile; un task iniziato sì.
          && (d.stato != "richiesta" || d.responsabileUid == null)
          && (d.stato in ["richiesta", "da_fare", "annullato"] || d.responsabileUid != null);
      }

      // Admin: tutto, anche spostarlo di commissione.
      function modificaAdmin(d, o) {
        return isAdmin(f)
          && (d.commissioneId == o.commissioneId || commissioneEsiste(d.commissioneId))
          && (d.responsabileUid == o.responsabileUid || d.responsabileUid == null || attivo(d.responsabileUid));
      }

      // Referente: tutto sui task della sua commissione, senza spostarli.
      function modificaReferente(d, o) {
        return isReferente(f, o.commissioneId)
          && d.commissioneId == o.commissioneId
          && (d.responsabileUid == o.responsabileUid || puoAssegnare(o.commissioneId, d.responsabileUid));
      }

      // Responsabile: stato, checklist, link e motivo del blocco; se il task se l'è dato da solo, anche i dati.
      // Mai commissione o responsabile.
      function modificaResponsabile(d, o) {
        let proprio = o.createdBy == io() && o.get("richiestoDa", null) == null;
        return isMembro(f) && o.responsabileUid == io()
          && o.stato in ["da_fare", "in_corso", "bloccato", "fatto"]
          && (changedOnly(["stato", "checklist", "link", "motivoBlocco", "updatedAt", "updatedBy"])
            || (proprio && changedOnly(["stato", "checklist", "link", "motivoBlocco", "titolo", "descrizione", "scadenza", "priorita", "updatedAt", "updatedBy"])))
          && (d.stato in ["da_fare", "in_corso", "bloccato", "fatto"] || (proprio && d.stato == "annullato"));
      }

      // Creatore (diverso dal responsabile): modifica o annulla solo finché è "Da fare".
      function modificaCreatore(d, o) {
        return isMembro(f) && o.createdBy == io() && o.get("richiestoDa", null) == null
          && o.stato == "da_fare"
          && changedOnly(["titolo", "descrizione", "scadenza", "priorita", "checklist", "link", "stato", "updatedAt", "updatedBy"])
          && d.stato in ["da_fare", "annullato"];
      }

      // Richiedente: modifica o ritira finché è una richiesta.
      function modificaRichiedente(d, o) {
        return isMembro(f) && o.get("richiestoDa", null) == io()
          && o.stato == "richiesta"
          && changedOnly(["titolo", "descrizione", "scadenza", "priorita", "checklist", "link", "stato", "updatedAt", "updatedBy"])
          && d.stato in ["richiesta", "annullato"];
      }

      match /tasks/{t} {
        allow read: if isMembro(f) || isSuperadmin();

        allow create: if scrivibile(f) && auditCreate()
          && taskValido(request.resource.data)
          && request.resource.data.eliminato == false
          && commissioneEsiste(request.resource.data.commissioneId)
          && (
            // Task normale, assegnato a chi posso scegliere.
            (request.resource.data.stato == "da_fare"
              && !("richiestoDa" in request.resource.data)
              && puoAssegnare(request.resource.data.commissioneId, request.resource.data.responsabileUid))
            // Richiesta a una commissione di cui non faccio parte (l'admin il task lo crea direttamente).
            || (request.resource.data.stato == "richiesta"
              && request.resource.data.get("richiestoDa", null) == io()
              && isMembro(f) && !isAdmin(f) && ruolo(f, request.resource.data.commissioneId) == null)
          );

        allow update: if scrivibile(f) && auditUpdate()
          && taskValido(request.resource.data)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["createdAt", "createdBy", "richiestoDa"])
          && (modificaAdmin(request.resource.data, resource.data)
            || modificaReferente(request.resource.data, resource.data)
            || modificaResponsabile(request.resource.data, resource.data)
            || modificaCreatore(request.resource.data, resource.data)
            || modificaRichiedente(request.resource.data, resource.data));

        function task() { return get(/databases/$(database)/documents/feste/$(f)/tasks/$(t)).data; }
        function testoValido(d) { return d.testo is string && d.testo.size() >= 1 && d.testo.size() <= 2000; }

        // Commenti: li scrive chiunque nella festa; li modificano l'autore (entro 15 minuti) e referenti/admin.
        match /commenti/{id} {
          allow read: if isMembro(f) || isSuperadmin();
          allow create: if scrivibile(f) && (isMembro(f) || isSuperadmin())
            && request.resource.data.keys().hasOnly(["testo", "autoreUid", "createdAt"])
            && request.resource.data.autoreUid == io()
            && request.resource.data.createdAt == request.time
            && testoValido(request.resource.data);
          allow update: if scrivibile(f)
            && changedOnly(["testo", "modificatoAt"])
            && request.resource.data.modificatoAt == request.time
            && testoValido(request.resource.data)
            && ((isMembro(f) && resource.data.autoreUid == io() && request.time < resource.data.createdAt + duration.value(15, "m"))
              || canManage(f, task().commissioneId));
        }

        // Allegati: li aggiungono e tolgono il responsabile, i referenti della commissione e gli admin.
        // Il file sta in Storage allo stesso percorso (storage.rules ripete il controllo).
        function puoAllegare() {
          return canManage(f, task().commissioneId) || (isMembro(f) && task().responsabileUid == io());
        }
        match /allegati/{id} {
          allow read: if isMembro(f) || isSuperadmin();
          allow create: if scrivibile(f) && puoAllegare()
            && request.resource.data.keys().hasOnly(["nome", "mime", "path", "createdAt", "createdBy"])
            && request.resource.data.createdBy == io()
            && request.resource.data.createdAt == request.time
            && request.resource.data.nome is string && request.resource.data.nome.size() >= 1 && request.resource.data.nome.size() <= 200
            && request.resource.data.mime is string && request.resource.data.mime.size() <= 100
            && request.resource.data.path == "feste/" + f + "/tasks/" + t + "/" + id;
          allow delete: if scrivibile(f) && puoAllegare();
        }
      }

      // ---- Spese e rimborsi (SPEC 4.5) ----

      function commissione(c) { return get(/databases/$(database)/documents/feste/$(f)/commissioni/$(c)).data; }

      // Spese sulle commissioni di cui faccio parte o su "Generale"; l'admin ovunque.
      function puoSpendereIn(c) {
        return isAdmin(f) || (isMembro(f) && (ruolo(f, c) != null || commissione(c).generale == true));
      }

      function pagatoDaValido(p) {
        return p is map && p.keys().hasOnly(["tipo", "beneficiarioUid", "beneficiarioNome"])
          && (p.tipo == "cassa"
            ? p.keys().hasOnly(["tipo"])
            // Anticipata: una persona della festa oppure un nome scritto a mano.
            : p.tipo == "anticipata" && (
                (p.keys().hasOnly(["tipo", "beneficiarioUid", "beneficiarioNome"]) && p.get("beneficiarioUid", null) is string && attivo(p.beneficiarioUid))
                || (p.keys().hasOnly(["tipo", "beneficiarioNome"]) && p.get("beneficiarioNome", null) is string
                  && p.beneficiarioNome.size() >= 1 && p.beneficiarioNome.size() <= 80)));
      }

      function spesaValida(d) {
        return d.keys().hasOnly(["tipo", "commissioneId", "descrizione", "importoCents", "categoria", "dataSpesa", "pagatoDa",
               "stato", "motivo", "approvatoDa", "approvatoAt", "autoApprovata", "rimborsoId", "scontrini", "eliminato",
               "createdAt", "createdBy", "updatedAt", "updatedBy"])
          && d.tipo == "spesa"
          && d.commissioneId is string
          && d.descrizione is string && d.descrizione.size() >= 1 && d.descrizione.size() <= 200
          && d.importoCents is int && d.importoCents > 0 && d.importoCents <= 10000000
          && d.categoria in festa(f).categorieSpesa
          && d.dataSpesa is timestamp
          && pagatoDaValido(d.pagatoDa)
          && d.scontrini is list && d.scontrini.size() <= 5
          && d.eliminato is bool;
      }

      // Stato, motivo, approvazione e rimborso li scrivono solo le Functions (SPEC 4.6).
      match /movimenti/{mv} {
        allow read: if isMembro(f) || isSuperadmin();

        allow create: if scrivibile(f) && auditCreate()
          && spesaValida(request.resource.data)
          && request.resource.data.stato == "in_attesa"
          && request.resource.data.eliminato == false
          && !request.resource.data.keys().hasAny(["motivo", "approvatoDa", "approvatoAt", "autoApprovata", "rimborsoId"])
          && commissioneEsiste(request.resource.data.commissioneId)
          && puoSpendereIn(request.resource.data.commissioneId);

        // Modificare o ritirare (eliminato) prima dell'approvazione: autore, referenti della commissione, admin.
        allow update: if scrivibile(f) && auditUpdate()
          && resource.data.tipo == "spesa"
          && resource.data.stato in ["in_attesa", "rifiutata"]
          && spesaValida(request.resource.data)
          && changedOnly(["commissioneId", "descrizione", "importoCents", "categoria", "dataSpesa", "pagatoDa", "scontrini",
               "eliminato", "updatedAt", "updatedBy"])
          && ((isMembro(f) && resource.data.createdBy == io()) || canManage(f, resource.data.commissioneId))
          && (request.resource.data.commissioneId == resource.data.commissioneId
            || (commissioneEsiste(request.resource.data.commissioneId) && puoSpendereIn(request.resource.data.commissioneId)));
      }

      // Rimborsi: solo Functions.
      match /rimborsi/{r} {
        allow read: if isMembro(f) || isSuperadmin();
      }

      // ---- Sito pubblico (SPEC 7.3) ----

      // I contenuti pubblici della festa li vede chiunque solo se è in evidenza o nell'archivio.
      function pubblica() {
        return inEvidenza(f)
          || (exists(/databases/$(database)/documents/sitoFeste/$(f))
            && get(/databases/$(database)/documents/sitoFeste/$(f)).data.inArchivioPubblico == true);
      }

      function eventoValido(d) {
        return d.keys().hasOnly(["titolo", "inizio", "fine", "puntoId", "descrizione", "ordine",
               "createdAt", "createdBy", "updatedAt", "updatedBy"])
          && d.titolo is string && d.titolo.size() >= 1 && d.titolo.size() <= 120
          && d.inizio is timestamp
          && (!("fine" in d) || (d.fine is timestamp && d.fine >= d.inizio))
          && optString(d, "puntoId", 100)
          && optString(d, "descrizione", 2000)
          && d.ordine is int;
      }

      // Programma: lo curano gli admin della festa.
      match /programma/{id} {
        allow read: if pubblica() || isMembro(f) || isSuperadmin();
        allow create: if isAdmin(f) && scrivibile(f) && auditCreate() && eventoValido(request.resource.data);
        allow update: if isAdmin(f) && scrivibile(f) && auditUpdate() && eventoValido(request.resource.data)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["createdAt", "createdBy"]);
        allow delete: if isAdmin(f) && scrivibile(f);
      }

      // Avvisi (SPEC 7.1): li scrivono gli admin; in home compaiono solo quelli attivi.
      function avvisoValido(d) {
        return d.keys().hasOnly(["testo", "tipo", "attivo", "createdAt", "createdBy", "updatedAt", "updatedBy"])
          && d.testo is string && d.testo.size() >= 1 && d.testo.size() <= 500
          && d.tipo in ["info", "importante"]
          && d.attivo is bool;
      }
      match /avvisi/{id} {
        allow read: if pubblica() || isMembro(f) || isSuperadmin();
        allow create: if isAdmin(f) && scrivibile(f) && auditCreate() && avvisoValido(request.resource.data);
        allow update: if isAdmin(f) && scrivibile(f) && auditUpdate() && avvisoValido(request.resource.data)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["createdAt", "createdBy"]);
        allow delete: if isAdmin(f) && scrivibile(f);
      }

      // Mappa: immagine (ridotta al caricamento) e punti con coordinate relative 0..1. La curano gli admin.
      function coordinata(v) { return (v is int || v is float) && v >= 0 && v <= 1; }
      function puntoValido(d) {
        return d.keys().hasOnly(["nome", "categoria", "x", "y", "descrizione", "foto", "orari", "accessibile",
               "createdAt", "createdBy", "updatedAt", "updatedBy"])
          && d.nome is string && d.nome.size() >= 1 && d.nome.size() <= 80
          && d.categoria in ["bagni", "mangiare", "bere", "eventi", "parcheggio", "info", "soccorso", "wifi", "altro"]
          && coordinata(d.x) && coordinata(d.y)
          && optString(d, "descrizione", 1000)
          && optString(d, "orari", 200)
          && urlOpt(d, "foto")
          && d.accessibile is bool;
      }
      function immagineValida(i) {
        return i is map && i.keys().hasOnly(["url", "larghezza", "altezza"]) && urlValido(i.url)
          && i.larghezza is int && i.larghezza > 0 && i.altezza is int && i.altezza > 0;
      }
      // Wi-Fi della festa (SPEC 7.3): nome della rete, password WPA facoltativa, punto della mappa.
      function wifiValido(w) {
        return w is map && w.keys().hasOnly(["nomeRete", "password", "puntoId"])
          && w.nomeRete is string && w.nomeRete.size() >= 1 && w.nomeRete.size() <= 32
          && (!("password" in w) || (w.password is string && w.password.size() >= 8 && w.password.size() <= 63))
          && optString(w, "puntoId", 100);
      }
      match /mappa/{doc} {
        allow read: if doc == "config" && (pubblica() || isMembro(f) || isSuperadmin());
        allow create, update: if doc == "config" && isAdmin(f) && scrivibile(f) && auditUpdate()
          && request.resource.data.keys().hasOnly(["immagine", "wifi", "updatedAt", "updatedBy"])
          && (!("immagine" in request.resource.data) || immagineValida(request.resource.data.immagine))
          && (!("wifi" in request.resource.data) || wifiValido(request.resource.data.wifi));

        match /punti/{id} {
          allow read: if doc == "config" && (pubblica() || isMembro(f) || isSuperadmin());
          allow create: if doc == "config" && isAdmin(f) && scrivibile(f) && auditCreate() && puntoValido(request.resource.data);
          allow update: if doc == "config" && isAdmin(f) && scrivibile(f) && auditUpdate() && puntoValido(request.resource.data)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["createdAt", "createdBy"]);
          allow delete: if doc == "config" && isAdmin(f) && scrivibile(f);
        }
      }
    }
  }
}
