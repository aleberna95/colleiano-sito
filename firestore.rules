rules_version = '2';

// Le regole sono la fonte di verità dei permessi (SPEC 4).
// lib/permissions.ts le replica per la UI: tenerli allineati.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSuperadmin() { return signedIn() && request.auth.token.superadmin == true; }
    function m(f) { return get(/databases/$(database)/documents/feste/$(f)/membri/$(request.auth.uid)).data; }
    function isMembro(f) { return signedIn() && exists(/databases/$(database)/documents/feste/$(f)/membri/$(request.auth.uid)) && m(f).attivo == true; }
    function isAdmin(f) { return isSuperadmin() || (isMembro(f) && m(f).ruoloFesta == "admin"); }
    function ruolo(f, c) { return m(f).commissioni.get(c, null); }
    function isReferente(f, c) { return isMembro(f) && ruolo(f, c) == "referente"; }
    function canManage(f, c) { return isAdmin(f) || isReferente(f, c); }

    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function changedOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // Tutto ciò che non è aperto qui sotto resta chiuso.

    // Profili: li crea e modifica la Function (o lo script di bootstrap).
    // L'utente può solo segnare di aver cambiato la password e ricordare l'ultima festa.
    match /users/{uid} {
      allow read: if isSelf(uid) || isSuperadmin();
      allow update: if isSelf(uid)
        && resource.data.attivo == true
        && changedOnly(["devoCambiarePassword", "ultimaFestaId", "updatedAt", "updatedBy"])
        && request.resource.data.devoCambiarePassword == false
        && request.resource.data.updatedBy == uid
        && request.resource.data.updatedAt == request.time
        && (!("ultimaFestaId" in request.resource.data) || request.resource.data.ultimaFestaId is string);
    }

    match /feste/{f} {
      allow read: if isSuperadmin();
    }
  }
}
